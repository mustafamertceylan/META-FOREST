@model MetaForest.Models.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap - Meta Forest";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-lg p-4" style="background-color: #1a1c23; border: 1px solid #00ffcc;">
            <h2 class="text-center mb-4" style="color: #00ffcc;">Ormana Dönüş</h2>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label text-light"></label>
                    <input asp-for="Email" class="form-control bg-dark text-light border-secondary" placeholder="ornek@mail.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label text-light"></label>
                    <input asp-for="Password" class="form-control bg-dark text-light border-secondary" placeholder="******" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn w-100 fw-bold" style="background-color: #00ffcc; color: #000;">GİRİŞ YAP</button>
            </form>

            <div class="text-center mt-3">
                <a asp-action="Register" class="text-decoration-none" style="color: #2ecc71;">Henüz ormanda yerin yok mu? Kayıt Ol</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}