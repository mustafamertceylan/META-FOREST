@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@inject MetaForest.Services.IWeatherService WeatherService

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MetaForest</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            body {
                background-color: #0d0e12;
                color: #ffffff;
            }

            .navbar-custom {
                background-color: #1a1c23;
                border-bottom: 2px solid #2ecc71;
            }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-custom navbar-dark box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-success" asp-area="" asp-controller="Home" asp-action="Index">🌳 MetaForest</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>

                        @* Eğer kullanıcı giriş yaptıysa ve ADMIN ise bu menüyü görsün *@
                        @if (SignInManager.IsSignedIn(User) && User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-area="" asp-controller="Home" asp-action="AdminPanel">⚙️ Yönetici Paneli</a>
                            </li>
                        }

                        @* Hava Durumu Bilgisi *@
                        @{
                            try
                            {
                                var weather = await WeatherService.GetWeatherAsync();
                                if (weather != null && !weather.IsError)
                                {
                                    <li class="nav-item ms-3">
                                        <span class="nav-link text-info" title="@weather.WeatherDescription - Hava hissi: @weather.FeelsLike°C, Nem: %@weather.Humidity">
                                            @weather.FormattedWeather
                                        </span>
                                    </li>
                                }
                            }
                            catch (Exception)
                            {
                                <!-- Hava durumu hatasını sessizce yoksay -->
                            }
                        }
                    </ul>

                    @* Sağ taraftaki Giriş/Kayıt/Çıkış Butonları (Dinamik Alan) *@
                    <ul class="navbar-nav">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item d-flex align-items-center me-3">
                                <span class="text-info fw-bold">👋 Merhaba, @UserManager.GetUserName(User)</span>
                                @if (User.IsInRole("Admin"))
                                {
                                    <span class="badge bg-danger ms-2">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-success ms-2">User</span>
                                }
                            </li>
                            <li class="nav-item">
                                <form class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-dangerfw-bold">Güvenli Çıkış</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-success" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted position-fixed bottom-0 w-100 py-2" style="background-color: #1a1c23; border-color: #2ecc71 !important;">
        <div class="container text-center text-secondary">
            &copy; 2026 - MetaForest Oyunlaştırılmış Üretkenlik Platformu - Tasarım ve Mimari Kurallara Uygundur.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>