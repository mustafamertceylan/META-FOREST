@{
	ViewData["Title"] = "Bölge Seçin - Meta-Forest";
}

<style>
	.realm-container {
		min-height: 100vh;
		background: linear-gradient(135deg, #0f0f1e 0%, #1a1c23 100%);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		padding: 40px 20px;
	}

	.realm-header {
		text-align: center;
		margin-bottom: 60px;
		animation: fadeInDown 0.8s ease;
	}

	.realm-header h1 {
		font-size: 3.5rem;
		background: linear-gradient(135deg, #2ecc71 0%, #3498db 50%, #e74c3c 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		margin-bottom: 15px;
		font-weight: 900;
		text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
	}

	.realm-header p {
		font-size: 1.2rem;
		color: #bdc3c7;
		letter-spacing: 2px;
	}

	.realm-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 30px;
		max-width: 1200px;
		width: 100%;
		margin-bottom: 40px;
	}

	.realm-card {
		position: relative;
		height: 400px;
		border-radius: 20px;
		overflow: hidden;
		cursor: pointer;
		transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
		border: 3px solid rgba(255, 255, 255, 0.1);
		animation: fadeInUp 0.8s ease;
	}

	/* DRAGON REALM KARTI */
	.realm-card.dragon {
		background: linear-gradient(135deg, #2c1810 0%, #3d2415 100%);
		border-color: #ff6b35;
	}

	.realm-card.dragon:hover {
		border-color: #e74c3c;
		box-shadow: 
			0 30px 80px rgba(231, 76, 60, 0.4),
			0 0 40px rgba(255, 107, 53, 0.3);
		transform: translateY(-15px) scale(1.03);
	}

	/* CYBER REALM KARTI */
	.realm-card.cyber {
		background: linear-gradient(135deg, #0f0f1e 0%, #1a1a3a 100%);
		border-color: #00ffff;
	}

	.realm-card.cyber:hover {
		border-color: #3498db;
		box-shadow: 
			0 30px 80px rgba(52, 152, 219, 0.4),
			0 0 40px rgba(0, 255, 255, 0.3);
		transform: translateY(-15px) scale(1.03);
	}

	/* CARTOON REALM KARTI */
	.realm-card.cartoon {
		background: linear-gradient(135deg, #1a3a1a 0%, #2d5a2d 100%);
		border-color: #52d452;
	}

	.realm-card.cartoon:hover {
		border-color: #2ecc71;
		box-shadow: 
			0 30px 80px rgba(46, 204, 113, 0.4),
			0 0 40px rgba(82, 212, 82, 0.3);
		transform: translateY(-15px) scale(1.03);
	}

	.realm-card-bg {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 8rem;
		opacity: 0.2;
		z-index: 1;
	}

	.realm-card-content {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.9), transparent);
		padding: 30px;
		z-index: 2;
		transform: translateY(20px);
		transition: transform 0.3s ease;
	}

	.realm-card:hover .realm-card-content {
		transform: translateY(0);
	}

	.realm-card-title {
		font-size: 1.8rem;
		font-weight: bold;
		margin-bottom: 10px;
		display: flex;
		align-items: center;
		gap: 10px;
	}

	.realm-card.dragon .realm-card-title {
		color: #ff6b35;
	}

	.realm-card.cyber .realm-card-title {
		color: #00ffff;
	}

	.realm-card.cartoon .realm-card-title {
		color: #52d452;
	}

	.realm-card-description {
		font-size: 0.95rem;
		color: #bdc3c7;
		line-height: 1.5;
		margin-bottom: 15px;
	}

	.realm-card-stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 10px;
		font-size: 0.85rem;
		text-align: center;
	}

	.stat {
		background: rgba(255, 255, 255, 0.05);
		padding: 8px;
		border-radius: 6px;
		border: 1px solid rgba(255, 255, 255, 0.1);
	}

	.stat-label {
		color: #999;
		font-size: 0.75rem;
		text-transform: uppercase;
	}

	.stat-value {
		color: #fff;
		font-weight: bold;
		font-size: 1.1rem;
	}

	.realm-card-button {
		display: none;
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		background: rgba(255, 255, 255, 0.9);
		color: #1a1c23;
		padding: 15px 40px;
		border-radius: 50px;
		font-weight: bold;
		font-size: 1.1rem;
		border: none;
		cursor: pointer;
		z-index: 3;
		transition: all 0.3s ease;
	}

	.realm-card:hover .realm-card-button {
		display: block;
		animation: popIn 0.4s ease;
	}

	.realm-card-button:hover {
		transform: translate(-50%, -50%) scale(1.05);
		background: #2ecc71;
		color: white;
	}

	/* İNFO BÖLÜMÜ */
	.realm-info {
		background: rgba(255, 255, 255, 0.05);
		border: 2px solid rgba(255, 255, 255, 0.1);
		border-radius: 15px;
		padding: 30px;
		max-width: 900px;
		width: 100%;
		backdrop-filter: blur(10px);
	}

	.realm-info h3 {
		color: #2ecc71;
		margin-bottom: 15px;
		font-size: 1.3rem;
	}

	.realm-info p {
		color: #bdc3c7;
		line-height: 1.6;
		margin-bottom: 10px;
	}

	/* ANİMASYONLAR */
	@@keyframes fadeInDown {
		from {
			opacity: 0;
			transform: translateY(-30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@@keyframes fadeInUp {
		from {
			opacity: 0;
			transform: translateY(30px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@@keyframes popIn {
		from {
			transform: translate(-50%, -50%) scale(0.7);
			opacity: 0;
		}
		to {
			transform: translate(-50%, -50%) scale(1);
			opacity: 1;
		}
	}

	/* RESPONSİF */
	@@media (max-width: 768px) {
		.realm-grid {
			grid-template-columns: 1fr;
		}

		.realm-header h1 {
			font-size: 2rem;
		}

		.realm-card {
			height: 300px;
		}
	}
</style>

<div class="realm-container">
	<!-- BAŞLIK -->
	<div class="realm-header">
		<h1>🌍 META-FOREST</h1>
		<p>Hangi bölgeyi ziyaret etmek istersiniz?</p>
	</div>

	<!-- BÖLGE KARTLARI -->
	<div class="realm-grid">
		<!-- DRAGON REALM -->
		<div class="realm-card dragon" onclick="selectRealm('dragon')">
			<div class="realm-card-bg">🐉</div>
			<div class="realm-card-content">
				<div class="realm-card-title">
					<span style="color: #ff6b35;">🐉</span> Dragon Realm
				</div>
				<div class="realm-card-description">
					Lava ateşi ve ejderhaların hüküm sürdüğü yanardağ bölgesi. Cesur maceracılar için!
				</div>
				<div class="realm-card-stats">
					<div class="stat">
						<div class="stat-label">Zorluk</div>
						<div class="stat-value">★★★</div>
					</div>
					<div class="stat">
						<div class="stat-label">Ödül</div>
						<div class="stat-value">+500</div>
					</div>
					<div class="stat">
						<div class="stat-label">Tema</div>
						<div class="stat-value">Lava</div>
					</div>
				</div>
			</div>
			<button class="realm-card-button">Gir →</button>
		</div>

		<!-- CYBER-SPACE -->
		<div class="realm-card cyber" onclick="selectRealm('cyber')">
			<div class="realm-card-bg">⚡</div>
			<div class="realm-card-content">
				<div class="realm-card-title">
					<span style="color: #00ffff;">⚡</span> Cyber-Space
				</div>
				<div class="realm-card-description">
					Neon ışıklarının parlak olduğu dijital uzay. Gelecek burada başlıyor!
				</div>
				<div class="realm-card-stats">
					<div class="stat">
						<div class="stat-label">Zorluk</div>
						<div class="stat-value">★★</div>
					</div>
					<div class="stat">
						<div class="stat-label">Ödül</div>
						<div class="stat-value">+300</div>
					</div>
					<div class="stat">
						<div class="stat-label">Tema</div>
						<div class="stat-value">Neon</div>
					</div>
				</div>
			</div>
			<button class="realm-card-button">Gir →</button>
		</div>

		<!-- CARTOON UNIVERSE -->
		<div class="realm-card cartoon" onclick="selectRealm('cartoon')">
			<div class="realm-card-bg">🎨</div>
			<div class="realm-card-content">
				<div class="realm-card-title">
					<span style="color: #52d452;">🎨</span> Cartoon Universe
				</div>
				<div class="realm-card-description">
					Renkli ve neşeli çizgi film dünyası. Tüm seviyeler için müthiş eğlence!
				</div>
				<div class="realm-card-stats">
					<div class="stat">
						<div class="stat-label">Zorluk</div>
						<div class="stat-value">★</div>
					</div>
					<div class="stat">
						<div class="stat-label">Ödül</div>
						<div class="stat-value">+200</div>
					</div>
					<div class="stat">
						<div class="stat-label">Tema</div>
						<div class="stat-value">Doğa</div>
					</div>
				</div>
			</div>
			<button class="realm-card-button">Gir →</button>
		</div>
	</div>

	<!-- İNFO BÖLÜMÜ -->
	<div class="realm-info">
		<h3>📖 Bölgeler Hakkında</h3>
		<p>
			<strong>Meta-Forest</strong>'teki her bölge bağımsızdır. Bir bölgede yetiştirdiğiniz ağaçları diğer bölgelere taşıyamazsınız. 
			Her bölgenin kendi teması, karakterleri ve özel ödülleri vardır. Seçtiğiniz bölgede odaklanma seanslarını tamamlayarak 
			dijital varlıklar kazanın ve ormanınızı büyütün!
		</p>
		<p>
			💡 <strong>İpucu:</strong> Her bölgede en az bir oturum açmayı deneyin ve hangi stili daha çok sevdiğinizi bulun!
		</p>
	</div>
</div>

@section Scripts {
	<script>
		function selectRealm(realmName) {
			// Bölge seçimini sessionStorage'a kaydet
			sessionStorage.setItem('selectedRealm', realmName);

			// Ana sayfaya yönlendir
			window.location.href = `/?realm=${realmName}`;
		}
	</script>
}
