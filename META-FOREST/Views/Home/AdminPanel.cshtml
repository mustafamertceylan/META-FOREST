@model IEnumerable<MetaForest.Models.RewardAsset>

@{
	ViewData["Title"] = "Yönetici Paneli";
}

<div class="container-fluid mt-5 mb-5">
	<div class="row">
		<div class="col-12">
			<div class="card shadow-lg" style="background-color: #1a1c23; border: 2px solid #3498db;">
				<div class="card-header" style="background-color: #0d0f15; border-bottom: 2px solid #3498db;">
					<div class="d-flex justify-content-between align-items-center">
						<h1 class="text-info mb-0">
							<i class="fas fa-tachometer-alt"></i> Yönetici Paneli
						</h1>
						<a href="#" class="btn btn-success btn-lg shadow">
							<i class="fas fa-plus-circle"></i> Yeni Varlık Ekle
						</a>
					</div>
				</div>

				<div class="card-body p-4">
					<div class="table-responsive">
						<table class="table table-dark table-hover table-bordered align-middle">
							<thead style="background-color: #2c2f3a; border-color: #3498db;">
								<tr>
									<th style="border-color: #3498db; color: #3498db;">
										<i class="fas fa-hashtag"></i> ID
									</th>
									<th style="border-color: #3498db; color: #3498db;">
										<i class="fas fa-gem"></i> Varlık Adı
									</th>
									<th style="border-color: #3498db; color: #3498db;">
										<i class="fas fa-globe"></i> Bölge (Realm)
									</th>
									<th style="border-color: #3498db; color: #3498db;">
										<i class="fas fa-star"></i> Evrim Fazı (Phase)
									</th>
									<th style="border-color: #3498db; color: #3498db;">
										<i class="fas fa-video"></i> Video Dosyası
									</th>
								</tr>
							</thead>
							<tbody style="border-color: #4f5366;">
								@if (Model != null && Model.Any())
								{
									@foreach (var asset in Model)
									{
										<tr style="background-color: #1a1c23;">
											<td style="border-color: #4f5366; color: #ecf0f1;">
												<span class="badge bg-info">@asset.Id</span>
											</td>
											<td style="border-color: #4f5366; color: #ecf0f1;">
												<strong>@asset.Name</strong>
											</td>
											<td style="border-color: #4f5366; color: #ecf0f1;">
												<span class="badge bg-warning text-dark">@asset.RealmType?.ToUpper()</span>
											</td>
											<td style="border-color: #4f5366; color: #ecf0f1;">
												<span class="badge bg-danger">Faz @asset.PhaseLevel</span>
											</td>
											<td style="border-color: #4f5366; color: #ecf0f1;">
												<code style="color: #2ecc71;">@asset.WebmFileName</code>
											</td>
										</tr>
									}
								}
								else
								{
									<tr style="background-color: #1a1c23;">
										<td colspan="5" class="text-center text-warning py-4">
											<i class="fas fa-inbox"></i> Henüz hiç varlık eklenmiş değil.
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>

				<div class="card-footer" style="background-color: #0d0f15; border-top: 2px solid #3498db;">
					<p class="text-secondary text-center mb-0">
						<small>
							<i class="fas fa-info-circle"></i>
							Toplam Varlık Sayısı: <strong class="text-info">@(Model?.Count() ?? 0)</strong>
						</small>
					</p>
				</div>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		// Admin Panel için gelecek JavaScript kodları buraya yazılacak
	</script>
}
