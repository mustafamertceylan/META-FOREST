@{
    ViewData["Title"] = "Meta-Orman | Odaklanarak Büyü. Evreni İnşa Et.";
    Layout = "_LayoutLanding";
}

<link rel="stylesheet" href="~/css/landing.css" />

<div class="landing-container">
    <!-- Header -->
    <div class="header-section">
        <div class="logo-brand">
            🌳 Meta-Orman
        </div>
        <div class="header-actions">
            <a href="/Account/Login" class="btn-header btn-learn">Giriş Yap</a>
            <a href="~/Home/Index" class="btn-header btn-start">Başla</a>
        </div>
    </div>

    <!-- Hero Section -->
    <div class="hero-section">
        <div class="hero-content">
            <h1>
                <span class="hero-highlight">Odaklan. Büyü.</span><br>
                <span class="hero-highlight">Evreni İnşa Et.</span>
            </h1>
            <p>
                Her odaklanma seansı, dijital evreninde yaşayan bir varlığa dönüşür. Ederha yumurtalarından neon ağaçlara, kendi Meta-Ormanınızı oluşturun.
            </p>

            <div class="stats-section">
                <div class="stat-item">
                    <div class="stat-number">10K+</div>
                    <div class="stat-label">Aktif Kullanıcı</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">500K+</div>
                    <div class="stat-label">Odaklanma Saati</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">3</div>
                    <div class="stat-label">Farklı Evren</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number">∞</div>
                    <div class="stat-label">Ödül Varlığı</div>
                </div>
            </div>

            <div class="hero-buttons">
                <a href="~/Home/Index" class="btn-primary">Odaklama Başlat →</a>
                <button class="btn-secondary">Zaten Üyeyim</button>
            </div>
        </div>
    </div>

    <!-- Featured Events -->
    <div class="featured-section">
        <h2 class="section-title">Üç Farklı Evren</h2>
        <p class="section-subtitle">
            Her tema kendi hikayesi ile birlikte gelen bir evrene dönüşür. O bölgeyle ilgili varlıkları keşfet.
        </p>

        <div class="events-grid">
            <div class="event-card">
                <div class="event-icon">🌳</div>
                <div class="event-label">Doğa Teması</div>
                <div class="event-name">Siber Orman</div>
                <div class="event-description">
                    Neon ışıklı ağaçlar ile holografik bir orman. Bu bölgede büyütüğünüz varlıklar harika görünüyor.
                </div>
            </div>

            <div class="event-card">
                <div class="event-icon">🔥</div>
                <div class="event-label">Fantazi Teması</div>
                <div class="event-name">Ejderha Diyarı</div>
                <div class="event-description">
                    Volkanik dağların arasında ejderhalar besleyin. Her odaklanma seansı yeni bir ejderha yaratır.
                </div>
            </div>

            <div class="event-card">
                <div class="event-icon">🎨</div>
                <div class="event-label">Çizgi Film Teması</div>
                <div class="event-name">Çizgi Film Adası</div>
                <div class="event-description">
                    Renkli ve oyuncu karakterlerle dolu bir adada hayaller gerçekleşir. Komik ve eğlenceli varlıklar.
                </div>
            </div>
        </div>
    </div>

    <!-- Features -->
    <div class="features-section">
        <h2 class="section-title">Her Şey Bir Arada</h2>

        <div class="features-grid">
            <div class="feature-item">
                <div class="feature-icon">🍅</div>
                <div class="feature-title">Pomadora Sistemi</div>
                <div class="feature-description">
                    Odaklanabildiğiniz kadar uzun süreli ya da kısa süreli çalışma seansları.
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-icon">🌍</div>
                <div class="feature-title">Meta-Orman</div>
                <div class="feature-description">
                    Her başarılı seans, ormanınıza yeni bir varlık ekler. Ormanınızı dizayn edin.
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-icon">🔲</div>
                <div class="feature-title">Sürükle & Bırak</div>
                <div class="feature-description">
                    Kazandığınız karakterleri ızgarada istediğiniz yere yerleştirebilirsiniz.
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-icon">🌀</div>
                <div class="feature-title">Dinamik Atmosfer</div>
                <div class="feature-description">
                    Gerçek zamanında değişen iklim ve hava durumu simülasyonları eklenmiştir.
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-icon">📊</div>
                <div class="feature-title">Harita Analiz</div>
                <div class="feature-description">
                    Odaklanma istatistiklerinizi takip edin ve gelişimizi görüntüleyin.
                </div>
            </div>

            <div class="feature-item">
                <div class="feature-icon">👥</div>
                <div class="feature-title">Hakkında Analiz</div>
                <div class="feature-description">
                    Odaklanmada başarılı olan topluluktan öğrenin ve ilham alın.
                </div>
            </div>
        </div>
    </div>

    <!-- CTA Section -->
    <div class="cta-section">
        <div class="cta-stars">⭐⭐⭐⭐⭐</div>
        <h2 class="cta-title">Ormanını Büyütmeye Hazır mısın?</h2>
        <p class="cta-description">
            Ücretsiz kaydol, ilk odaklanma seanını başlat ve dijital varlıklarını yetiştime yolculuğuna başla.
        </p>
        <a href="~/Home/Index" class="btn-primary">Ücretsiz Başla →</a>
    </div>

    <!-- Footer -->
    <div class="footer-section">
        <div>© 2025 Meta-Orman. Tüm Hakları Saklıdır. | Odaklan. Büyü. Evreni İnşa Et.</div>
    </div>
</div>
