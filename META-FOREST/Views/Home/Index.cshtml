@model IEnumerable<MetaForest.Models.PlantedAsset>

@{
	ViewData["Title"] = "Meta Ormanım - İsometrik";
	string currentRealm = ViewBag.SelectedRealm ?? "cyber";

	string themeClass = currentRealm switch
	{
		"dragon" => "theme-dragon",
		"cyber" => "theme-cyber",
		"cartoon" => "theme-cartoon",
		_ => "theme-cartoon"
	};

	string realmIcon = currentRealm switch
	{
		"dragon" => "🐉",
		"cyber" => "⚡",
		"cartoon" => "🎨",
		_ => "🌍"
	};

	string realmTitle = currentRealm switch
	{
		"dragon" => "Dragon Realm",
		"cyber" => "Cyber-Space",
		"cartoon" => "Cartoon Universe",
		_ => "Meta-Forest"
	};
}

<!DOCTYPE html>
<html class="@themeClass">
<head>
	<link rel="stylesheet" href="~/css/isometric.css" />
</head>
<body>

<div class="container-fluid py-5">

	<!-- BAŞLIK VE BÖLGE SEÇİCİ -->
	<div class="row mb-4">
		<div class="col-12">
			<div style="text-align: center; margin-bottom: 30px;">
				<h1 style="font-size: 2.5rem; color: var(--primary-color); margin-bottom: 10px;">
					@realmIcon @realmTitle
				</h1>
				<p style="color: var(--text-secondary); font-size: 1.1rem;">
					🏝️ Dijital Ormanınıza Hoş Geldiniz
				</p>
			</div>

			<!-- BÖLGE SEÇİCİ DÜĞMELERI -->
			<div class="realm-selector justify-content-center">
				<a href="?realm=dragon" class="realm-btn @(currentRealm == "dragon" ? "active" : "")">
					🐉 Dragon Realm
				</a>
				<a href="?realm=cyber" class="realm-btn @(currentRealm == "cyber" ? "active" : "")">
					⚡ Cyber-Space
				</a>
				<a href="?realm=cartoon" class="realm-btn @(currentRealm == "cartoon" ? "active" : "")">
					🎨 Cartoon Universe
				</a>
			</div>
		</div>
	</div>

	<div class="row">
		<!-- SOL PANEL - ODAKLANMA TİMERİ -->
		<div class="col-lg-3 col-md-4 mb-4">
			<div class="card h-100 shadow-lg" style="border: 3px solid var(--primary-color); background: var(--card-bg);">
				<div class="card-header" style="background: var(--primary-color); color: var(--dark-bg); font-weight: bold; text-align: center; padding: 15px;">
					⏱️ ODAKLANMA SAYACI
				</div>

				<div class="card-body text-center">
					<!-- SÜRESİ SEÇ -->
					<div class="mb-3">
						<label style="color: var(--text-secondary); font-size: 0.9rem; text-transform: uppercase;">Faz Seç</label>
						<select id="timerDuration" class="form-select" style="background: var(--dark-bg); color: var(--text-light); border-color: var(--border-color);">
							<option value="10">10 Saniye (Faz 1 Test)</option>
							<option value="30">30 Dakika (Faz 2)</option>
							<option value="60">60 Dakika (Faz 3)</option>
						</select>
					</div>

					<!-- BÜYÜK SAYAÇ -->
					<div id="countdownDisplay" style="font-size: 4rem; font-weight: 900; color: var(--primary-color); font-family: 'Courier New', monospace; margin: 20px 0; text-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);">
						00:10
					</div>

					<!-- BUTONLAR -->
					<div class="d-grid gap-2">
						<button id="btnStart" class="btn btn-lg fw-bold" style="background: var(--primary-color); color: var(--dark-bg); border: none;">
							▶️ BAŞLAT
						</button>
						<button id="btnGiveUp" class="btn btn-lg fw-bold d-none" style="background: var(--secondary-color); color: var(--dark-bg); border: none;">
							⏹️ PES ET
						</button>
					</div>

					<!-- İPUCU -->
					<p style="color: var(--text-secondary); font-size: 0.85rem; margin-top: 15px; border-top: 1px solid var(--border-color); padding-top: 15px;">
						💡 Seansı tamamlayın ve yeni ağaçlar kazanın!
					</p>
				</div>
			</div>
		</div>

		<!-- SAĞ PANEL - İSOMETRİK GRID -->
		<div class="col-lg-9 col-md-8">
			<div style="background: linear-gradient(135deg, var(--card-bg) 0%, rgba(0, 0, 0, 0.3) 100%); border-radius: 20px; border: 3px solid var(--border-color); padding: 30px; box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);">

				<h3 style="color: var(--primary-color); margin-bottom: 20px; text-align: center;">
					🌳 5x5 İsometrik Orman Izgarası
				</h3>

				<!-- İSOMETRİK GRID -->
				<div class="isometric-grid">
					@for (int y = 0; y < 5; y++)
					{
						@for (int x = 0; x < 5; x++)
						{
							var planted = Model?.FirstOrDefault(p => p.GridX == x && p.GridY == y);

							<div class="isometric-cell" 
								 data-x="@x" data-y="@y"
								 ondragover="onDragOver(event)" 
								 ondrop="onDrop(event)"
								 @(planted != null ? "class='active'" : "")>

								@if (planted != null)
								{
									<div class="cell-content planted-asset" 
										 draggable="true" 
										 data-asset-id="@planted.Id"
										 ondragstart="onDragStart(event)"
										 ondragend="onDragEnd(event)">
										<video class="cell-video" autoplay loop muted playsinline>
											<source src="/assets/animations/@planted.RewardAsset.WebmFileName" type="video/webm">
										</video>
										<span class="cell-badge">F@planted.RewardAsset.PhaseLevel</span>
									</div>
								}
							</div>
						}
					}
				</div>

				<p style="color: var(--text-secondary); text-align: center; margin-top: 20px; font-size: 0.9rem;">
					💚 Seansa tamamlayın ve rastgele bir kareye ağaç eklenecektir
				</p>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		// ========== SÜRÜKLE-BIRAK ALTYAPI ==========
		let draggedElement = null;

		function onDragStart(event) {
			draggedElement = event.currentTarget;
			event.dataTransfer.effectAllowed = "move";
			event.currentTarget.style.opacity = "0.6";
		}

		function onDragOver(event) {
			event.preventDefault();
			event.dataTransfer.dropEffect = "move";
			event.currentTarget.style.backgroundColor = "rgba(255, 255, 255, 0.1)";
		}

		function onDragEnd(event) {
			if (draggedElement) draggedElement.style.opacity = "1";
			document.querySelectorAll('.isometric-cell').forEach(cell => {
				cell.style.backgroundColor = "transparent";
			});
		}

		function onDrop(event) {
			event.preventDefault();
			if (!draggedElement) return;

			const targetCell = event.currentTarget;
			const assetId = draggedElement.dataset.assetId;
			const newX = targetCell.dataset.x;
			const newY = targetCell.dataset.y;

			const existingAsset = targetCell.querySelector('.planted-asset');
			if (existingAsset && existingAsset !== draggedElement) {
				alert("Bu kare zaten dolu!");
				draggedElement.style.opacity = "1";
				return;
			}

			targetCell.innerHTML = '';
			targetCell.appendChild(draggedElement);

			fetch('/Home/MoveAsset', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					assetId: parseInt(assetId),
					newX: parseInt(newX),
					newY: parseInt(newY)
				})
			})
			.then(r => r.json())
			.then(data => {
				if (!data.success) {
					alert("Hata oluştu!");
					location.reload();
				}
			})
			.catch(e => {
				console.error(e);
				location.reload();
			});

			draggedElement.style.opacity = "1";
		}

		// ========== TIMER ALTYAPI ==========
		let timer = null, totalSeconds = 10, isRunning = false;
		const currentRealm = "@currentRealm";
		const durationSelect = document.getElementById('timerDuration');
		const display = document.getElementById('countdownDisplay');
		const btnStart = document.getElementById('btnStart');
		const btnGiveUp = document.getElementById('btnGiveUp');

		durationSelect.addEventListener('change', function() {
			if (!isRunning) {
				totalSeconds = this.value == "10" ? 10 : this.value * 60;
				updateDisplay();
			}
		});

		function updateDisplay() {
			let minutes = Math.floor(totalSeconds / 60);
			let seconds = totalSeconds % 60;
			display.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
		}

		btnStart.addEventListener('click', function() {
			if (!isRunning) {
				isRunning = true;
				durationSelect.disabled = true;
				btnStart.classList.add('d-none');
				btnGiveUp.classList.remove('d-none');
				totalSeconds = durationSelect.value == "10" ? 10 : durationSelect.value * 60;

				timer = setInterval(function() {
					totalSeconds--;
					updateDisplay();
					if (totalSeconds <= 0) {
						clearInterval(timer);
						onFocusComplete();
					}
				}, 1000);
			}
		});

		btnGiveUp.addEventListener('click', function() {
			clearInterval(timer);
			isRunning = false;
			durationSelect.disabled = false;
			btnStart.classList.remove('d-none');
			btnGiveUp.classList.add('d-none');
			totalSeconds = durationSelect.value == "10" ? 10 : durationSelect.value * 60;
			updateDisplay();
			alert("Seans iptal edildi.");
		});

		function onFocusComplete() {
			isRunning = false;
			durationSelect.disabled = false;
			btnStart.classList.remove('d-none');
			btnGiveUp.classList.add('d-none');

			const emptyCells = [];
			document.querySelectorAll('.isometric-cell').forEach(cell => {
				if (cell.children.length === 0) {
					emptyCells.push({ x: cell.dataset.x, y: cell.dataset.y });
				}
			});

			if (emptyCells.length === 0) {
				alert("Tebrikler! Ormanınız tamamen doldu!");
				return;
			}

			const randomCell = emptyCells[Math.floor(Math.random() * emptyCells.length)];
			const selectedMinutes = durationSelect.value;

			fetch(`/Home/CompleteSession?durationMinutes=${selectedMinutes}&realm=${currentRealm}&gridX=${randomCell.x}&gridY=${randomCell.y}`, {
				method: 'POST'
			})
			.then(response => response.json())
			.then(data => {
				if (data.success) {
					alert(`🎉 ${data.assetName} kazandınız!`);
					location.reload();
				}
			});
		}
	</script>
}

</body>
</html>
