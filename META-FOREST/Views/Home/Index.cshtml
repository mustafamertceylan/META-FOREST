@model IEnumerable<MetaForest.Models.PlantedAsset>

@{
    ViewData["Title"] = "Meta Ormanım";
    string currentRealm = ViewBag.SelectedRealm ?? "cyber";
}

<div class="row mt-4">
    <div class="col-md-4 text-center">
        <div class="card p-4 shadow mb-4" style="background-color: #1a1c23; border: 2px solid #3498db;">
            <h4 class="text-info mb-3">🌌 Ada Bölgesi Seç</h4>
            <div class="btn-group w-100 mb-4">
                <a href="?realm=cyber" class="btn btn-sm @(currentRealm == "cyber" ? "btn-info" : "btn-outline-info")">⚡ Siber Uzay</a>
                <a href="?realm=dragon" class="btn btn-sm @(currentRealm == "dragon" ? "btn-danger" : "btn-outline-danger")">🔥 Ejderha</a>
                <a href="?realm=cartoon" class="btn btn-sm @(currentRealm == "cartoon" ? "btn-warning" : "btn-outline-warning")">🎨 Çizgi Film</a>
            </div>

            <hr style="border-color: #3498db;" />

            <h3 class="text-light mt-3">⏱️ Odaklanma Sayacı</h3>

            <div class="mb-3">
                <select id="timerDuration" class="form-select bg-dark text-light border-secondary">
                    <option value="1">1 Dakika (Test Faz 1)</option>
                    <option value="30">30 Dakika (Test Faz 2)</option>
                    <option value="60">60 Dakika (Test Faz 3)</option>
                </select>
            </div>

            <div id="countdownDisplay" class="display-1 fw-bold my-4 text-success" style="font-family: monospace;">01:00</div>

            <button id="btnStart" class="btn btn-lg btn-success w-100 fw-bold shadow">ODAKLANMAYI BAŞLAT</button>
            <button id="btnGiveUp" class="btn btn-lg btn-danger w-100 fw-bold mt-2 d-none">PES ET (Sıfırla)</button>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card p-3 shadow text-center" style="background-color: #1a1c23; border: 2px solid #2ecc71;">
            <h4 class="mb-3" style="color: #2ecc71;">🏝️ Dijital Orman Bölgeniz (@currentRealm.ToUpper())</h4>
            <p class="text-secondary small">Süre bittiğinde karakteriniz haritada rastgele boş bir kareye kök salacaktır.</p>

            <div class="grid-container d-flex flex-wrap justify-content-center m-auto" style="max-width: 450px;">
                @for (int y = 0; y < 5; y++)
                {
                    @for (int x = 0; x < 5; x++)
                    {
                        // Bu koordinatta daha önce dikilmiş bir ağaç var mı kontrol et
                        var planted = Model.FirstOrDefault(p => p.GridX == x && p.GridY == y);

                        <div class="grid-cell border d-flex align-items-center justify-content-center m-1 shadow-sm"
                             data-x="@x" data-y="@y"
                             style="width: 75px; height: 75px; background-color: #2c2f3a; border-color: #4f5366 !important; border-radius: 8px; position: relative;">

                            @if (planted != null)
                            {
                                <video width="65" height="65" autoplay loop muted playsinline style="pointer-events: none;">
                                    <source src="/assets/animations/@planted.RewardAsset.WebmFileName" type="video/webm">
                                </video>
                                <span class="position-absolute bottom-0 start-50 translate-middle-x badge bg-dark opacity-75" style="font-size: 8px;">F @planted.RewardAsset.PhaseLevel</span>
                            }
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let timer = null;
        let totalSeconds = 60;
        let isRunning = false;
        const currentRealm = "@currentRealm";

        const durationSelect = document.getElementById('timerDuration');
        const display = document.getElementById('countdownDisplay');
        const btnStart = document.getElementById('btnStart');
        const btnGiveUp = document.getElementById('btnGiveUp');

        // Süre seçimi değiştiğinde ekranı güncelle
        durationSelect.addEventListener('change', function() {
            if(!isRunning) {
                totalSeconds = this.value * 60;
                updateDisplay();
            }
        });

        function updateDisplay() {
            let minutes = Math.floor(totalSeconds / 60);
            let seconds = totalSeconds % 60;
            display.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;
        }

        btnStart.addEventListener('click', function() {
            if (!isRunning) {
                // Sayacı Başlat
                isRunning = true;
                durationSelect.disabled = true;
                btnStart.classList.add('d-none');
                btnGiveUp.classList.remove('d-none');
                totalSeconds = durationSelect.value * 60;
                updateDisplay();

                timer = setInterval(function() {
                    totalSeconds--;
                    updateDisplay();

                    if (totalSeconds <= 0) {
                        clearInterval(timer);
                        onFocusComplete();
                    }
                }, 1000);
            }
        });

        btnGiveUp.addEventListener('click', function() {
            // Pes Etme Durumu
            clearInterval(timer);
            isRunning = false;
            durationSelect.disabled = false;
            btnStart.classList.remove('d-none');
            btnGiveUp.classList.add('d-none');
            totalSeconds = durationSelect.value * 60;
            updateDisplay();
            alert("Odaklanma seansı iptal edildi. Karakter kazanamadınız. 😢");
        });

        // BAŞARIYLA TAMAMLANDIĞINDA TETİKLENEN AJAX FONKSİYONU
        function onFocusComplete() {
            isRunning = false;
            durationSelect.disabled = false;
            btnStart.classList.remove('d-none');
            btnGiveUp.classList.add('d-none');

            // Haritadaki boş kareleri tespit et
            const emptyCells = [];
            document.querySelectorAll('.grid-cell').forEach(cell => {
                if (cell.children.length === 0) {
                    emptyCells.push({ x: cell.dataset.x, y: cell.dataset.y });
                }
            });

            if (emptyCells.length === 0) {
                alert("Tebrikler! Odaklandınız ama adanızda hiç boş yer kalmadı!");
                return;
            }

            // Boş karelerden rastgele birini seç
            const randomCell = emptyCells[Math.floor(Math.random() * emptyCells.length)];
            const selectedMinutes = durationSelect.value;

            // Arka plana (Backend) veriyi gönderiyoruz (CRUD - Ekleme)
            fetch(`/Home/CompleteSession?durationMinutes=${selectedMinutes}&realm=${currentRealm}&gridX=${randomCell.x}&gridY=${randomCell.y}`, {
                method: 'POST'
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert(`🎉 Harika iş! ${selectedMinutes} dakika odaklanarak "${data.assetName}" kazandınız ve adanıza eklendi!`);
                    location.reload(); // Haritayı güncellemek için sayfayı yenile
                }
            });
        }
    </script>
}